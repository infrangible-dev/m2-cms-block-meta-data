{
    "name": "infrangible/m2-cms-block-meta-data",
    "description": "Adds meta title, meta keywords and meta description fields to CMS blocks and applies them to the page on which the block is shown as a widget.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "SEO",
        "Content",
        "meta data for CMS blocks",
        "meta title from widgets",
        "CMS block SEO fields"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-cms-block-meta-data",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CmsBlockMetaData\\": "src"
        }
    }
}
